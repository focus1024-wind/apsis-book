# Build output of the Rust crate.
/target

# Frontend dependencies and build output. The build output is embedded in
# the binary by build.rs and is not committed.
/frontend/node_modules
/frontend/dist

# Editor and operating system files.
.DS_Store
*.swp
*~

# Vite and TypeScript caches.
/frontend/.vite
/frontend/*.tsbuildinfo

# Session exports dropped into the project directory by tooling that runs
# alongside it. They are large and unrelated to the service.
apsis-book.html

# Diagnostics dropped beside the project while working on it, such as the
# screenshots of a page under inspection.
/tmp
